{
  "name": "genpark-cinematic-storyboard-scene-sequence-synthesizer-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Cinematic storyboard scene sequence synthesizer generating shot compositions, camera angles, and continuity sheets.",
  "author": "genpark",
  "category": "cinematics",
